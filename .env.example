# ============================================================================
# DeepWiki intranet deployment configuration (.env)
# Copy this file to .env and edit the values for YOUR internal environment.
#   cp .env.example .env
# ============================================================================

# --- Web / API ---
PORT=8001

# --- Internal AI gateway (chat / wiki generation) ---
# Everything generation-related is routed to your internal OpenAI-compatible
# endpoint. DeepWiki only talks to this address - no external internet access.
OPENAI_BASE_URL=http://192.168.1.10:8080/v1
OPENAI_API_KEY=your-internal-gateway-key

# Default provider / model used when the frontend doesn't override them.
# For a fully intranet deployment you usually only expose the internal
# OpenAI-compatible endpoint, so pin it as the default.
DEEPWIKI_DEFAULT_PROVIDER=openai
DEEPWIKI_DEFAULT_MODEL=qwen2.5-32b-instruct

# --- Internal embedding API ---
# Uses the SAME base URL as the chat gateway above unless you set a dedicated
# embedding endpoint. DEEPWIKI_EMBED_MODEL must match a model served by your
# internal embed API (e.g. text-embedding-v3, bge-m3, ...).
DEEPWIKI_EMBED_MODEL=text-embedding-v3
# (optional) separate embedding endpoint / key:
# DEEPWIKI_EMBED_BASE_URL=http://192.168.1.11:8081/v1
# DEEPWIKI_EMBED_API_KEY=your-embed-key

# --- SVN checkout (optional) ---
# Default credentials for private SVN repos when the per-request token doesn't
# carry a username (token may also be "username:password").
# SVN_USERNAME=svnuser
# SVN_PASSWORD=svnpass

# --- Authorization mode (optional) ---
# Restrict wiki generation / cache deletion to holders of an auth code.
# DEEPWIKI_AUTH_MODE=true
# DEEPWIKI_AUTH_CODE=change-me

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE_PATH=api/logs/application.log
